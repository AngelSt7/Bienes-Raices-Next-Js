generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  lastname     String
  email        String  @unique
  password     String?
  authProvider String  @default("manual")
  confirmed    Boolean @default(false)
  age          Int?
  number       Int?
  token        Token[]
}

model Token {
  id          Int      @id @default(autoincrement())
  userId      Int
  token       Int
  expiresAt   DateTime 
  user        User     @relation(fields: [userId], references: [id])
}
